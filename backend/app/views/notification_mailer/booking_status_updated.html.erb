<h2 style="margin: 0 0 12px; font-size: 18px; color: #0f172a;">
  Booking Status Updated
</h2>
<p style="font-size: 14px; line-height: 1.6; color: #475569; margin: 0 0 20px;">
  Hello <%= @user.name.presence || "Customer" %>, there is an update on your booking for <strong><%= @service.name %></strong> (<%= @booking.reference_number %>).
</p>

<div class="detail-box">
  <table style="width: 100%;">
    <tr>
      <td style="padding: 6px 0; font-size: 13px; color: #64748b;">Current Status:</td>
      <td style="padding: 6px 0; font-size: 13px; font-weight: 700; color: #176B65; text-align: right;">
        <%= @new_status.to_s.humanize.upcase %>
      </td>
    </tr>
    <% if @provider %>
    <tr>
      <td style="padding: 6px 0; font-size: 13px; color: #64748b;">Assigned Professional:</td>
      <td style="padding: 6px 0; font-size: 13px; font-weight: 600; color: #0f172a; text-align: right;">
        <%= @provider.name %> (<%= @provider.phone %>)
      </td>
    </tr>
    <% end %>
    <tr>
      <td style="padding: 6px 0; font-size: 13px; color: #64748b;">Scheduled Time:</td>
      <td style="padding: 6px 0; font-size: 13px; font-weight: 600; color: #0f172a; text-align: right;">
        <%= @booking.scheduled_at&.strftime("%A, %d %b %Y at %I:%M %p") || "Scheduled" %>
      </td>
    </tr>
  </table>
</div>

<p style="text-align: center; margin: 28px 0 16px;">
  <a href="<%= @portal_url %>" class="btn-primary">View Status in App</a>
</p>

