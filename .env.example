# LocalHelp Environment Variables
# Copy this file to .env and fill in the values

# ── Database ──────────────────────────────────────────
DATABASE_URL=postgresql://localhelp:localhelp_dev@localhost:5432/localhelp_development

# ── JWT ───────────────────────────────────────────────
JWT_SECRET_KEY=replace_with_a_secure_random_string_64_chars
JWT_ACCESS_TOKEN_EXPIRY=900        # 15 minutes in seconds
JWT_REFRESH_TOKEN_EXPIRY=2592000   # 30 days in seconds

# ── Google OAuth ──────────────────────────────────────
# Obtain client credentials from Google Cloud Console (OAuth 2.0 Client IDs for Web Application)
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── OTP / SMS (MSG91) ────────────────────────────────
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=LCHELP
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_HOURLY_RATE_LIMIT=5

# ── Email (Resend) ───────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@localhelp.com

# ── Firebase Cloud Messaging ─────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_JSON=

# ── Payments (Razorpay) ──────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── File Storage (S3-compatible) ─────────────────────
STORAGE_SERVICE=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_BUCKET=localhelp-uploads
AWS_ENDPOINT=

# ── Platform ─────────────────────────────────────────
SUPPORT_PHONE=+911234567890
SUPPORT_WHATSAPP=+911234567890
PLATFORM_NAME=LocalHelp

# ── Rails ────────────────────────────────────────────
RAILS_ENV=development
RAILS_LOG_LEVEL=debug
RAILS_MAX_THREADS=5

