# LocalHelp Mobile App Environment Variables
# Copy this file to .env in the mobile folder

# When running on iOS Simulator: http://localhost:4000/api/v1
# When running on Android Emulator: http://10.0.2.2:4000/api/v1
# When testing on physical phone via Expo Go: http://<YOUR_MAC_IP>:4000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
